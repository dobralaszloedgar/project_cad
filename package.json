{
  "name": "project-cad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assistant": "node --env-file-if-exists=.env.local --import tsx scripts/assistant.ts",
    "assistant:build": "node scripts/assistant/build.mjs",
    "assistant:package": "node scripts/assistant/package-macos.mjs",
    "assistant:package-windows": "node scripts/assistant/package-portable.mjs win32",
    "assistant:package-linux": "node scripts/assistant/package-portable.mjs linux",
    "assistant:publish": "node scripts/assistant/publish-github.mjs",
    "assistant:export-downloads": "node scripts/assistant/export-downloads.mjs",
    "assistant:stage-downloads": "node scripts/assistant/publish-github.mjs --sync-only",
    "assistant:verify": "node scripts/assistant/verify-macos.mjs",
    "assistant:verify-portable": "node scripts/assistant/verify-portable.mjs",
    "assistant:verify-downloads": "node scripts/assistant/verify-downloads.mjs",
    "assistant:verify-providers": "node scripts/assistant/verify-providers.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{ts,mjs,json}\"",
    "thermo:build": "node scripts/build-thermo.mjs",
    "catalog:import": "node --import tsx scripts/catalog/import.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@fontsource-variable/figtree": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@xyflow/react": "12.12.0",
    "idb": "8.0.4",
    "lucide-react": "1.62.0",
    "motion": "14.8.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "daisyui": "5.7.50",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
