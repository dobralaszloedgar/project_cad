# Dependencies and build output
node_modules/
.next/
/dist/
*.tsbuildinfo
rust/thermo/target/

# Local configuration and credentials
.env*
!.env.example
/.vercel/
supabase/.temp/

# Test reports, caches and scratch files
playwright-report/
.playwright-mcp/
test-results/
coverage/
/.tmp/
/tmp/
__pycache__/
*.py[cod]
*.log

# Operating system and editor files
.DS_Store
Thumbs.db
Desktop.ini
/.idea/

# Track published Markdown and the Next.js agent instructions.
# Other Markdown remains local planning material unless explicitly allowlisted.
*.[mM][dD]
*.[mM][dD][xX]
!/README.md
!/AGENTS.md
!/docs/**/*.md
!/.github/**/*.md

# Local agent tooling
.agents/
.agent/
.codex/
.claude/
.cursor/
.impeccable/
agent-artifacts/
agents/

# Muse CLI local configuration, sessions, cache and diagnostics
.muse/
.muse
.muse-*/
.muse-*
.muse.*
muse-debug.log*
muse-error.log*
muse.local.*

# Staged assistant downloads; only the published manifest belongs in Git
public/downloads/assistant/*
!public/downloads/assistant/downloads.json
!public/downloads/assistant/downloads.json.license

# Native 4K/120 FPS review exports are regenerated locally; deploy the smaller web derivatives.
public/landing-media/*-120.mp4
public/landing-media/*.pending.mp4
