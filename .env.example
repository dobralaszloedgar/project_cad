# Source development only. Desktop users can enter the Muse key in assistant settings.
# Leave empty to use Codex or Claude Code sign-in.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Live inference is off by default. Enable only on a trusted local server.
META_AI_ENABLED=false

# Optional companion settings; restart npm run assistant after changing these.
# PROJECT_CAD_APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# PROJECT_CAD_ASSISTANT_DATA=/absolute/path/to/assistant-history
# PROJECT_CAD_CODEX_BIN=/absolute/path/to/codex
# PROJECT_CAD_CLAUDE_BIN=/absolute/path/to/claude
