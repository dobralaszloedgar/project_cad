# Copy this file to .env.local and fill in the settings you need.
# Keep actual credentials in .env.local; use placeholders only in this file.

# Chemical property catalog (server only)
# Import a release with scripts/catalog/build.py and npm run catalog:import.
# Model selection and immutable data records are saved with each local project.
# Bundled sample mixtures also work without a configured database.

# local = PostgreSQL connection; cloud = hosted Supabase Data API.
CHEMICAL_DATABASE_MODE=local

# Local PostgreSQL connection for catalog reads and data imports.
# Example: postgresql://postgres:REPLACE_WITH_PASSWORD@127.0.0.1:54322/postgres
CHEMICAL_DATABASE_URL=

# Hosted catalog connection. Fill both values when configuring cloud mode.
# Project URL example: https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=
# Server-only secret API key (sb_secret_...). Never use a NEXT_PUBLIC_ prefix
# or include this key in browser code or distributed desktop/CLI packages.
SUPABASE_SECRET_KEY=

# Hosted PostgreSQL connection used only by migration/import tooling.
# Copy the session-pooler connection string from Supabase's Connect
# dialog and URL-encode special characters in the database password.
SUPABASE_DATABASE_URL=
# Path to the server root certificate downloaded from Database → Settings.
# Used for PostgreSQL imports/local mode. HTTPS Data API reads need no CA file.
CHEMICAL_DATABASE_SSL_CA_FILE=

# Supabase configuration references:
# https://supabase.com/docs/guides/getting-started/api-keys
# https://supabase.com/docs/guides/database/connecting-to-postgres

# Source development only. Desktop users can enter the Muse key in assistant settings.
# Leave empty to use Codex or Claude Code sign-in.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Live inference is off by default. Enable only on a trusted local server.
META_AI_ENABLED=false

# Optional companion settings; restart npm run assistant after changing these.
# PROJECT_CAD_APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# PROJECT_CAD_ASSISTANT_DATA=/absolute/path/to/assistant-history
# PROJECT_CAD_CODEX_BIN=/absolute/path/to/codex
# PROJECT_CAD_CLAUDE_BIN=/absolute/path/to/claude
